#!/usr/sbin/nft -f

# 1. Flush existing rules
flush ruleset

# 2. Define the Table
table inet traffic_shaper {

    # Define a Dynamic Set to track flows
    set flow_meter {
        # The key is the "5-tuple" identifying a flow
        type ipv4_addr . ipv4_addr . inet_service . inet_service . inet_proto
        flags dynamic
        timeout 60s
    }

    chain shaper {
        # Hook into the Forwarding path (packets passing through)
        # type filter hook output priority mangle; policy accept;
        type filter hook postrouting priority mangle; policy accept;

        # See if traffic hits this chain
        counter

        # --- Rule A: Restore Connection Mark ---
        # If this flow was already marked SLOW in the past, restore that mark to the current packet.
        meta mark set ct mark

        # Optimization: If packet is already marked SLOW, stop processing rules for it.
        meta mark 0x20 accept

        # --- Rule B: The Meter ---
        # 1. 'update @flow_meter': Create/Update entry for this flow
        # 2. 'limit rate over': Check if traffic EXCEEDS the limit
        #    - Rate: 500 mbits/second
        #    - Burst: 10 mbytes (The "Excess Data" buffer)
        # 3. If Exceeded: Set packet Mark AND Connection Mark to 0x20 (SLOW)
        
        # 500 Mbps = 62500 KBps = 41666.66 packets
        # 10 MB = 6666.66 packets
        update @flow_meter { ip saddr . ip daddr . th sport . th dport . meta l4proto \
                             limit rate over 41666/second burst 6666 packets \
                           } meta mark set 0x20 ct mark set 0x20
                             # limit rate over 62500 kbytes/second burst 10 mbytes \

        counter
    }
}

