From 1a7486ac30eb8d3e3d3c2b96248f14c5af6dd4ca Mon Sep 17 00:00:00 2001
From: Hendrik Cech <hendrik.cech@gmail.com>
Date: Wed, 20 May 2026 10:36:48 +0200
Subject: [PATCH 10/12] leocc: Fix global_reconfiguration_trigger

---
 net/ipv4/Makefile       | 2 +-
 net/ipv4/tcp_leocc.c    | 5 ++++-
 net/ipv4/tcp_leocc_nl.h | 6 +++---
 3 files changed, 8 insertions(+), 5 deletions(-)

diff --git a/net/ipv4/Makefile b/net/ipv4/Makefile
index 0b35896d8c6c..99d5bcd780bf 100644
--- a/net/ipv4/Makefile
+++ b/net/ipv4/Makefile
@@ -52,7 +52,7 @@ obj-$(CONFIG_TCP_CONG_CUBIC) += tcp_cubic.o
 obj-$(CONFIG_TCP_CONG_SUSS) += tcp_cubic_suss.o
 obj-$(CONFIG_TCP_CONG_SEARCH) += tcp_cubic_search.o
 obj-$(CONFIG_TCP_CONG_SEARCH) += tcp_cubic_hystartpp.o
-obj-$(CONFIG_TCP_CONG_SEARCH) += tcp_leocc.o
+obj-$(CONFIG_TCP_CONG_LEOCC) += tcp_leocc.o
 obj-$(CONFIG_TCP_CONG_DCTCP) += tcp_dctcp.o
 obj-$(CONFIG_TCP_CONG_WESTWOOD) += tcp_westwood.o
 obj-$(CONFIG_TCP_CONG_HSTCP) += tcp_highspeed.o
diff --git a/net/ipv4/tcp_leocc.c b/net/ipv4/tcp_leocc.c
index 0b24ebf72786..4de847ab0652 100644
--- a/net/ipv4/tcp_leocc.c
+++ b/net/ipv4/tcp_leocc.c
@@ -80,6 +80,8 @@ module_param(delta_thresh, uint, 0644);
 MODULE_PARM_DESC(delta_thresh, "delta threshold for reconfiguration");
 
 bool global_reconfiguration_trigger = false;
+EXPORT_SYMBOL(global_reconfiguration_trigger);
+
 u32 min_rtt_fluctuation = 0;
 
 static const u32 var_R = 4;
@@ -691,7 +693,8 @@ __bpf_kfunc static void leocc_main(struct sock *sk, u32 ack, int flag,
 				   const struct rate_sample *rs)
 {
 	struct leocc *leocc = inet_csk_ca(sk);
-	if (global_reconfiguration_trigger && !leocc->local_reconfiguration_trigger) {
+	if (READ_ONCE(global_reconfiguration_trigger) && !leocc->local_reconfiguration_trigger) {
+                printk(KERN_INFO "[leocc] global_reconfiguration_trigger=1");
 		leocc->local_reconfiguration_trigger = 1;
 	}
 
diff --git a/net/ipv4/tcp_leocc_nl.h b/net/ipv4/tcp_leocc_nl.h
index e3af14728f91..d68f033ca909 100644
--- a/net/ipv4/tcp_leocc_nl.h
+++ b/net/ipv4/tcp_leocc_nl.h
@@ -68,8 +68,8 @@ static void leocc_netlink_recv_msg(struct sk_buff *skb)
 
     u64 cur_time_ms = data->sec * 1000 + data->usec / 1000;
 
-    if (global_reconfiguration_trigger && reconfiguration_trigger_time_ms > 0 && cur_time_ms >= reconfiguration_trigger_time_ms + global_reconfiguration_trigger_duration) {
-        global_reconfiguration_trigger = false;
+    if (READ_ONCE(global_reconfiguration_trigger) && reconfiguration_trigger_time_ms > 0 && cur_time_ms >= reconfiguration_trigger_time_ms + global_reconfiguration_trigger_duration) {
+        WRITE_ONCE(global_reconfiguration_trigger, false);
     }
 
     if (!min_rtt_fluctuation_collection && reconfiguration_trigger_time_ms > 0 && cur_time_ms >= reconfiguration_trigger_time_ms + reconfiguration_rtt_ms) {
@@ -103,7 +103,7 @@ static void leocc_netlink_recv_msg(struct sk_buff *skb)
     }
 
     if (data->is_reconfig == 1) {
-        global_reconfiguration_trigger = true;
+        WRITE_ONCE(global_reconfiguration_trigger, true);
         u32 rtt_value_us = 0;
         if (kstrtouint(data->rtt_value_microseconds, 10, &rtt_value_us) == 0) {
             reconfiguration_trigger_time_ms = cur_time_ms;
-- 
2.54.0

